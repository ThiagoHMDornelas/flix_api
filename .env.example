# Copie este arquivo para .env e ajuste os valores.
# O arquivo .env NÃO deve ser versionado (já está no .gitignore).

# Chave secreta do Django (gere uma nova para produção).
SECRET_KEY=django-insecure-troque-esta-chave

# Modo de depuração: True em desenvolvimento, False em produção.
DEBUG=True

# Hosts permitidos, separados por vírgula.
ALLOWED_HOSTS=127.0.0.1,localhost
